# Токен от @BotFather
BOT_TOKEN=
# Твой Telegram id (сюда идут уведомления) и её id. Узнать: @userinfobot
OWNER_ID=
HER_ID=
HER_NAME=Снежинка
# Любая длинная случайная строка (защищает вебхук и /api/setup)
WEBHOOK_SECRET=
# Адрес на Vercel; если пусто — берётся VERCEL_PROJECT_PRODUCTION_URL
APP_URL=

# Upstash Redis (Vercel → Storage → Upstash for Redis подставит сам)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Напоминания «ты игноришь»: /api/cron пингует GitHub Actions
# (секрет репозитория CRON_SECRET = WEBHOOK_SECRET). 0 — выключить.
REMIND_MINUTES=10

# Только локально: открыть приложение в браузере без Telegram от имени этого id
DEV_USER_ID=
